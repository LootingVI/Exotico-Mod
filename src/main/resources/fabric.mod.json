{
  "schemaVersion": 1,
  "id": "exotico",
  "version": "${version}",
  "name": "Exotico",
  "description": "The ultimate Hypixel SkyBlock exotic armor scanner and highlighter. Detect rare colors, dyes, and glitched items in real-time.",
  "authors": [
    "Flori"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/exotico/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "de.flori.exotico.client.ExoticoDataGenerator"
    ],
    "client": [
      "de.flori.exotico.client.ExoticoClient"
    ],
    "main": [
      "de.flori.exotico.Exotico"
    ]
  },
  "mixins": [
    "exotico.mixins.json",
    {
      "config": "exotico.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}